APP_NAME=giffgaff 保号提醒
TIMEZONE=Asia/Shanghai
DATA_DIR=/app/data

# 部署时改为实际公网地址，例如 http://1.2.3.4:18080
PUBLIC_BASE_URL=http://127.0.0.1:18080

# 使用 `python -c "import secrets; print(secrets.token_urlsafe(48))"` 生成
APP_SECRET=change-me

# 请使用独立强密码，不要复用其他网站密码
ADMIN_PASSWORD=change-me
SECURE_COOKIES=false

PUSHPLUS_TOKEN=

QQ_SMTP_USER=example@qq.com
QQ_SMTP_AUTH_CODE=
QQ_EMAIL_TO=example@qq.com

INITIAL_LAST_SMS_DATE=2026-07-26
REMINDER_HOUR=10
CHECK_INTERVAL_SECONDS=900
BACKUP_RETENTION_DAYS=30
